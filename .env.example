# ============================================================
# RCT Platform — Переменные окружения (ОДИН СЕРВЕР REG.RU)
# ============================================================
# Скопируйте в .env и заполните значениями
# НЕ КОММИТЬТЕ В GIT!
# ============================================================

# ============================================================
# БАЗА ДАННЫХ (локальная на VPS)
# ============================================================
DB_USER=rkt_admin
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DATABASE_URL=postgresql://rkt_admin:YOUR_SECURE_PASSWORD_HERE@postgres:5432/rkt_hub

# ============================================================
# AI PROVIDERS (получить ключи)
# ============================================================
# Groq (бесплатно 1000/день): https://console.groq.com
GROQ_API_KEY=gsk_...

# Gemini (бесплатно 1500/день): https://aistudio.google.com
GEMINI_API_KEY=AIza...

# Claude (платно): https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-...

# DeepSeek (дёшево): https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# GigaChat (Сбер, РФ): https://developers.sber.ru
GIGACHAT_API_KEY=...

# SaluteSpeech (Сбер, РФ): https://developers.sber.ru
SALUTESPEECH_API_KEY=...

# YandexGPT (Яндекс, РФ): https://cloud.yandex.ru
YANDEXGPT_IAM_TOKEN=...
YANDEXGPT_FOLDER_ID=...

# ============================================================
# TELEGRAM (создать бота @BotFather)
# ============================================================
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TG_CHAT_ID=-1001234567890  # ID чата куда отправлять уведомления

# ============================================================
# N8N (админка)
# ============================================================
N8N_USER=admin
N8N_PASSWORD=YOUR_N8N_PASSWORD_HERE

# ============================================================
# ДОМЕНЫ (ОДИН СЕРВЕР, ТРИ ДОМЕНА)
# ============================================================
# Все домены должны указывать на один IP (VPS Reg.ru)

# Основной домен (rct-hub.ru)
DOMAIN=rct-hub.ru
DOMAIN_MAIN=rct-hub.ru

# AI Architect (aiarchi.ru)
DOMAIN_AI=aiarchi.ru

# Медоборудование (rct-med.ru)
DOMAIN_MED=rct-med.ru

# ============================================================
# SUPABASE (если используется как резерв)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://prparzgqevfelwsndmkc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gFeXATQGYxKx08BpeOedZg_7buTwVJq
